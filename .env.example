SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Modo do banco de dados ─────────────────────────────────────────────────────
# USE_SQLITE=True  → SQLite local (rodar na IDE sem instalar PostgreSQL)
# USE_SQLITE=False → PostgreSQL (produção / Docker)
USE_SQLITE=True

# ── Banco PostgreSQL (usado apenas quando USE_SQLITE=False) ────────────────────
POSTGRES_DB=db-portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432